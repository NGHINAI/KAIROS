# KAIROS environment template.
# Copy to .env and fill in real values. .env is gitignored.
#
# Bun loads .env automatically when running scripts from this directory.

# ──────────────────────────────────────────────────────────────────────
# Composio (Phase C.2.7 — connectors)
# ──────────────────────────────────────────────────────────────────────

# Composio API key. Get from app.composio.dev → Settings → API Keys.
# Single shared key serves all KAIROS users via Composio's multi-tenant userId scoping (Model A).
COMPOSIO_API_KEY=ak_your_composio_key_here

# Optional: disable Composio subsystem without removing the key.
# KAIROS_COMPOSIO_ENABLED=true

# Optional: poll interval (ms) for connection-state polling. Default: 300000 (5 min).
# KAIROS_COMPOSIO_POLL_MS=300000

# ──────────────────────────────────────────────────────────────────────
# Other env vars (add as needed)
# ──────────────────────────────────────────────────────────────────────

# Optional: override the LLM mode. Default: byo.
# KAIROS_MODE=byo            # uses Claude/Codex CLI subscriptions
# KAIROS_MODE=hosted         # routes to cheap APIs (gpt-5-nano, gemini-flash, kimi-k2.5)
# KAIROS_MODE=local          # Ollama-only

# Optional: provider API keys (for hosted mode without KAIROS Cloud)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# KIMI_API_KEY=
