# KAIROS sandbox runtime artifacts
state/
runtime/
bin/
local_cache/

# Bun / Node
node_modules/
bun.lockb
bun.lock

# Build output (regenerated by `bun run build` / xcode/swift build) — never commit.
apps/electron/dist/
.build/
*.dSYM/
apps/macos/**/*.app/
apps/macos/**/*.xcuserstate

# Generated VAD/ONNX assets (regenerated by `bun run copy-vad-assets` on predev/prebuild).
# Large (~40MB) binaries; not source. Kept out of git, rebuilt from node_modules.
apps/electron/src/renderer/public/vad/
apps/electron/src/renderer/assets/vad/

# Logs (in case any escape state/logs/)
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Secrets — never commit. Use .env.example for committed templates.
.env
.env.local
.env.*.local
